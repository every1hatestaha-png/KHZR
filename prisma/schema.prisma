generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String         @id @default(cuid())
  clerkId    String         @unique
  email      String?        @unique
  firstName  String?
  lastName   String?
  phone      String?
  role       Role           @default(CUSTOMER)
  newsletter Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  addresses  Address[]
  orders     Order[]
  promotionRedemptions PromotionRedemption[]
  reviews    Review[]
  wishlist   WishlistItem[]

  @@map("users")
}

model Address {
  id         String      @id @default(cuid())
  userId     String?
  type       AddressType @default(SHIPPING)
  firstName  String
  lastName   String
  phone      String?
  company    String?
  line1      String
  line2      String?
  area       String?
  city       String
  region     String?
  postalCode String
  country    String
  deliveryNotes String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  billings   Order[]     @relation("OrderBillingAddress")
  orders     Order[]     @relation("OrderShippingAddress")

  @@index([userId])
  @@map("addresses")
}

model Collection {
  id             String               @id @default(cuid())
  slug           String               @unique
  name           String
  description    String?
  editorial      String?
  imageUrl       String?
  isFeatured     Boolean              @default(false)
  sortOrder      Int                  @default(0)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  campaigns      CampaignCollection[]
  products       ProductCollection[]
  promotionTargets PromotionCollection[]

  @@map("collections")
}

model Product {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  subtitle        String?
  description     String?
  composition     String?
  care            String?
  price           Decimal             @db.Decimal(10, 2)
  compareAtPrice  Decimal?            @db.Decimal(10, 2)
  currency        Currency            @default(USD)
  status          ProductStatus       @default(DRAFT)
  stockStatus     StockStatus         @default(IN_STOCK)
  sku             String?             @unique
  isNew           Boolean             @default(false)
  isFeatured      Boolean             @default(false)
  averageRating   Decimal             @default(0) @db.Decimal(3, 2)
  reviewCount     Int                 @default(0)
  sortOrder       Int                 @default(0)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lookbookEntries LookbookEntry[]
  orderItems      OrderItem[]
  promotionTargets PromotionProduct[]
  collections     ProductCollection[]
  media           ProductMedia[]
  variants        ProductVariant[]
  reviews         Review[]
  wishlistItems   WishlistItem[]

  @@index([status, isFeatured])
  @@index([status, slug])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  size          String
  color         String
  colorHex      String?
  sku           String      @unique
  priceOverride Decimal?    @db.Decimal(10, 2)
  stock         Int         @default(0)
  lowStockAt    Int         @default(5)
  active        Boolean     @default(true)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, color])
  @@index([sku])
  @@map("product_variants")
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  publicId  String
  url       String
  alt       String
  kind      MediaKind @default(IMAGE)
  position  Int       @default(0)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_media")
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
  @@map("product_collections")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  token     String     @unique
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  userId            String?
  email             String?
  phone             String?
  status            OrderStatus       @default(PENDING)
  currency          Currency          @default(USD)
  subtotal          Decimal           @db.Decimal(10, 2)
  shippingTotal     Decimal           @db.Decimal(10, 2)
  shippingZone      String?
  freeShippingApplied Boolean         @default(false)
  taxTotal          Decimal           @db.Decimal(10, 2)
  discountTotal     Decimal           @default(0) @db.Decimal(10, 2)
  promotionId       String?
  couponCode        String?
  promotionType     String?
  total             Decimal           @db.Decimal(10, 2)
  shippingAddressId String?
  billingAddressId  String?
  customerNotes     String?
  internalNotes     String?
  fulfillmentStage  String            @default("pending")
  courier           String?
  trackingNumber    String?
  shippingDate      DateTime?
  expectedDelivery  DateTime?
  paymentVerifiedAt DateTime?
  paymentProvider   String            @default("stripe")
  providerSessionId String?           @unique
  providerPaymentId String?           @unique
  providerTransactionId String?       @unique
  providerReference String?
  providerResponseCode String?
  providerResponseMessage String?
  paymentInitiatedAt DateTime?
  paymentFailedAt   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  cancelledAt       DateTime?
  cartToken         String?
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  paymentStatus     PaymentStatus     @default(PENDING)
  refundedAt        DateTime?
  shippingMethod    String?
  items             OrderItem[]
  promotion         Promotion?        @relation(fields: [promotionId], references: [id])
  billingAddress    Address?          @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])
  shippingAddress   Address?          @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  user              User?             @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentProvider, createdAt])
  @@index([phone])
  @@index([cartToken])
  @@index([promotionId])
  @@map("orders")
}

model Promotion {
  id                 String                  @id @default(cuid())
  name               String
  code               String?                 @unique
  active             Boolean                 @default(true)
  trigger            PromotionTrigger        @default(COUPON)
  scope              PromotionScope          @default(STORE)
  discountType       PromotionDiscountType
  percentage         Decimal?                @db.Decimal(5, 2)
  amount             Decimal?                @db.Decimal(10, 2)
  startsAt           DateTime?
  endsAt             DateTime?
  maxUses            Int?
  usesPerCustomer    Int?
  minimumOrderValue  Decimal?                @db.Decimal(10, 2)
  usageCount         Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  orders             Order[]
  products           PromotionProduct[]
  collections        PromotionCollection[]
  redemptions        PromotionRedemption[]

  @@index([active, trigger])
  @@index([code])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

model PromotionCollection {
  promotionId  String
  collectionId String
  promotion    Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([promotionId, collectionId])
  @@map("promotion_collections")
}

model PromotionRedemption {
  id          String    @id @default(cuid())
  promotionId String
  orderId     String?
  userId      String?
  email       String?
  couponCode  String?
  amount      Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([promotionId, userId])
  @@index([promotionId, email])
  @@map("promotion_redemptions")
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  variantId String?
  productId String
  sku       String
  name      String
  size      String
  color     String
  unitPrice Decimal         @db.Decimal(10, 2)
  quantity  Int
  imageUrl  String?
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model ShippingZone {
  id                    String   @id @default(cuid())
  name                  String   @unique
  province              String
  cityMatch             String?
  amount                Decimal  @db.Decimal(10, 2)
  freeShippingThreshold Decimal  @db.Decimal(10, 2)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([province, cityMatch, active])
  @@map("shipping_zones")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Review {
  id         String   @id @default(cuid())
  userId     String?
  productId  String
  rating     Int
  title      String?
  body       String?
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  status     ReviewStatus @default(PENDING)
  isFeatured Boolean  @default(false)
  helpfulCount Int    @default(0)
  approvedAt DateTime?
  approvedBy String?
  adminReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  images     ReviewImage[]
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@index([productId, isApproved])
  @@index([productId, status])
  @@map("reviews")
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

model JournalPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String
  body           String
  coverImage     String
  author         String
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([publishedAt])
  @@map("journal_posts")
}

model Lookbook {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String?
  coverImage  String
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  entries     LookbookEntry[]

  @@map("lookbooks")
}

model LookbookEntry {
  id         String   @id @default(cuid())
  lookbookId String
  productId  String?
  imageUrl   String
  caption    String?
  position   Int      @default(0)
  lookbook   Lookbook @relation(fields: [lookbookId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])

  @@index([lookbookId, position])
  @@map("lookbook_entries")
}

model Campaign {
  id          String               @id @default(cuid())
  name        String
  kicker      String?
  title       String
  subtitle    String?
  ctaLabel    String?
  ctaHref     String?
  imageUrl    String
  position    Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  collections CampaignCollection[]

  @@map("campaigns")
}

model CampaignCollection {
  campaignId   String
  collectionId String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([campaignId, collectionId])
  @@map("campaign_collections")
}

model StoreSettings {
  id                    String   @id @default("store")
  storeName             String   @default("KHZR")
  ownerNotificationEmail String?
  customerSupportEmail  String?
  instagramUrl          String?
  facebookUrl           String?
  contactDetails        String?
  returnPolicyText      String?
  shippingPolicyText    String?
  footerLinks           Json?
  announcementText      String?
  announcementActive    Boolean  @default(false)
  heroImageUrl          String?
  heroLabel             String?
  heroHeading           String?
  heroDescription       String?
  heroButtonText        String?
  heroButtonLink        String?
  homepageCategoryLinks Json?
  signatureImageUrl     String?
  signatureKicker       String?
  signatureTitle        String?
  signatureSubtitle     String?
  signatureCtaLabel     String?
  signatureCtaHref      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String   @unique
  publicId  String?
  alt       String?
  source    String   @default("admin")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("media_assets")
}

enum Role {
  CUSTOMER
  EDITOR
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PRE_ORDER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PromotionTrigger {
  COUPON
  AUTOMATIC
}

enum PromotionScope {
  STORE
  PRODUCTS
  COLLECTIONS
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum Currency {
  USD
  EUR
  GBP
  PKR
}

enum AddressType {
  SHIPPING
  BILLING
}

enum MediaKind {
  IMAGE
  VIDEO
}
