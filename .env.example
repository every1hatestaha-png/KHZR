# KHZR environment contract
# Copy to .env.local for development or configure these in your production host.
# Never commit real secret values.

# Required in production
# Public canonical site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""

# PostgreSQL connection string used by Prisma for catalog, cart, orders, users and admin.
DATABASE_URL="postgresql://user:password@host:5432/khzr?sslmode=require"

# Current checkout is Pakistan-first, PKR-only and Cash on Delivery only.
# Stripe is legacy/disabled for checkout unless explicitly re-enabled in code.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Clerk is required for account/admin auth in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."

# Required for admin cache revalidation endpoints/actions.
REVALIDATE_SECRET="replace-with-a-long-random-secret"

# Integration-specific
# Optional unless Clerk webhooks are enabled.
CLERK_WEBHOOK_SECRET=""

# Required only for Cloudinary-backed admin uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="khzr"

# Required only when transactional emails should send through Resend.
RESEND_API_KEY=""
EMAIL_FROM="orders@example.com"

# Optional shared rate-limit backend. If absent, KHZR uses the built-in local fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Easypaisa online payment gateway. Keep secrets server-side only.
EASYPAISA_ENV="sandbox"
EASYPAISA_MERCHANT_ID=""
EASYPAISA_STORE_ID=""
EASYPAISA_USERNAME=""
EASYPAISA_PASSWORD=""
EASYPAISA_INTEGRITY_SALT=""
EASYPAISA_RETURN_URL="https://example.com/checkout/success"

# JazzCash Payment Gateway v4.2. Keep secrets server-side only.
JAZZCASH_ENV="sandbox"
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_RETURN_URL="https://example.com/checkout/success"
